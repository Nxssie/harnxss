# secrets.fish — REAL secrets, copied to ~/.config/fish/conf.d/secrets.fish
#
# fish auto-sources every ~/.config/fish/conf.d/*.fish at shell start, so these
# env vars are available whenever you launch opencode / codex / etc. from a shell.
# The real file is GITIGNORED — only this .example template is committed.
#
# After editing the real file:  exec fish   (to reload)

# LiteLLM gateway (llm.nxssie.dev) — single entry/exit point for all inference
# providers. Virtual key issued from the gateway's admin panel (/keys), used by
# opencode.json {env:NX_LLM_GATEWAY_KEY}, pi/extensions/llm.ts
# (process.env.NX_LLM_GATEWAY_KEY, fetched again at runtime for model refresh),
# codex/config.toml (env_key = "NX_LLM_GATEWAY_KEY") and ~/.factory/settings.json.
set -gx NX_LLM_GATEWAY_KEY "sk-xxxxxxxxxxxxxxxxxxxxxxxx"
