{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nan": {
      "type": "remote",
      "url": "https://api.nan.builders/mcp",
      "headers": {
        "Authorization": "Bearer {env:NAN_API_KEY}"
      }
    }
  },
  "provider": {
    "llm": {
      "models": {
        "nan-deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash 284B A13B"
        },
        "nan-gemma4": {
          "name": "Gemma 4 26B A4B"
        },
        "nan-mimo-v2.5": {
          "name": "Xiaomi MiMo V2.5 310B A15B"
        },
        "nan-qwen3.6": {
          "name": "Qwen 3.6 35B A3B"
        },
        "opencode-go-glm-5.2": {
          "name": "GLM 5.2"
        },
        "opencode-go-kimi-k3": {
          "name": "Kimi K3"
        }
      },
      "name": "LLM Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:NX_LLM_GATEWAY_KEY}",
        "baseURL": "https://llm.nxssie.dev/v1"
      }
    }
  }
}
